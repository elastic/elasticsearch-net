<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <!-- The converter faithfully reconstructs requests that use deprecated API. Generated enum FormatCode
         files (e.g. StreamType.g.cs) switch over deprecated enum members with no per-site pragmas, so this
         project-wide suppression is load-bearing, not redundant with the pragmas other generated files carry. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Elastic.Esql" Version="0.11.0" />
    <PackageReference Include="Elastic.Transport" Version="0.17.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RequestConverter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Elastic.Clients.Elasticsearch\**\*.cs" Exclude="**\bin\**;**\obj\**" LinkBase="Client" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="_Shared\" />
  </ItemGroup>

</Project>
