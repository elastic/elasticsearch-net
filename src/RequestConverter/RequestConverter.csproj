<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <!-- The request converter intentionally references deprecated API to faithfully convert any request. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Elastic.Esql" Version="0.11.0" />
    <PackageReference Include="Elastic.Transport" Version="0.17.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Elastic.Clients.Elasticsearch\**\*.cs" Exclude="**\bin\**;**\obj\**" LinkBase="Client" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="_Shared\" />
  </ItemGroup>

</Project>
